# RAG Chatbot Backend Environment Variables

# Environment
ENVIRONMENT=development
DEBUG=true

# Embedding Model Configuration (T002)
# Options: all-MiniLM-L6-v2, bge-small-en-v1.5, e5-small-v2
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_SIZE=1000

# Retrieval Configuration
TOP_K_RETRIEVAL=5
MIN_RELEVANCE_THRESHOLD=0.70

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.CFu_aVe-655sivVPXXfANzRdZVvmV4r6xl36jsaxq9g
# QDRANT_COLLECTION_NAME=documents
QDRANT_COLLECTION_NAME=docusues-book

# Neon PostgreSQL (optional, for metadata storage)
NEON_DB_URL=psql 'postgresql://neondb_owner:npg_btVNs0MZ7qPD@ep-gentle-term-ahnxklrg-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Quality Monitoring (T014)
LOG_QUALITY_METRICS=true
HALLUCINATION_DETECTION_ENABLED=true

# Performance Settings
MAX_QUERY_LENGTH=1000
MIN_QUERY_LENGTH=10
QUERY_TIMEOUT_SECONDS=30
