# Backend API Configuration
# ===========================
#
# Local Development:
#   Set this to your local FastAPI backend URL
REACT_APP_BACKEND_URL=http://localhost:8000

# Production (Vercel):
#   Set this in Vercel Dashboard → Settings → Environment Variables
#   Example values:
#     - https://mybook-backend.render.com
#     - https://mybook-backend.railway.app
#     - https://mybook-backend.fly.dev
#
# The chatbot widget uses this URL to call the RAG API:
#   POST {REACT_APP_BACKEND_URL}/api/rag/query?query_text=...

# Optional: Enable debug logging
DEBUG=false
